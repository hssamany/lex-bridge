RewriteEngine On
RewriteBase /lex-bridge/

# API routes - route to api/index.php
RewriteCond %{REQUEST_URI} ^/lex-bridge/api/
RewriteRule ^api/(.*)$ api/index.php [L,QSA]

# Static files - serve from public directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} \.(css|js|jpg|jpeg|png|gif|ico|svg|woff|woff2|ttf|eot|html)$
RewriteRule ^(.*)$ public/$1 [L]

# All other requests go to index.php in root
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
